{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Repo Manager",
  "version": "0.3.0",
  "identifier": "dev.repomanager.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Repo Manager",
        "width": 1120,
        "height": 720,
        "minWidth": 820,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#07090f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCRTM4NTU2NEZEQ0IxQ0MKUldUTXNkeFBWb1hqKzBva2NWbmgxSVowVURqS2ZvbytXOGpJNHl1aEJCbENsaFFoL1ZDNldCNkMK",
      "endpoints": [
        "https://github.com/zearkreast/repo-manager/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
